# Copy to `.env` and fill values. See `src/vite-env.d.ts` for Vite env typings.

# API (local dev — backend must be running on port 3000)
VITE_API_BASE_URL=http://localhost:3000/api/v1
# Staging/production example:
# VITE_API_BASE_URL=https://api.prestigeinteriordesign.com/api/v1

# Firebase (auth-related; admin login uses backend /auth/admin-login)
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
# Optional / deprecated — not used for creator photos (Cloudflare Images only)
# VITE_FIREBASE_STORAGE_BUCKET=

# Super Admin dashboard leaderboards: optional INR preview for coin amounts.
# When set, earnings/revenue/commission columns show ₹ = coins × this rate (display only).
# When unset, amounts show as grouped "coins" with an (coins) hint in the UI.
# VITE_DASHBOARD_INR_PER_COIN=0.25
